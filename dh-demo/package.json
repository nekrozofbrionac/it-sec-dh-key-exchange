{
  "name": "dh-demo",
  "version": "0.0.0",
  "description": "DH Key Exchange Demo",
  "main": "index.js",
  "scripts": {
    "build": "tsc && copyfiles -f src/*.html dist",
    "clean": "rimraf dist",
    "watch:html": "chokidar \"src/index.html\" -c \"cp src/index.html dist/index.html\"",
    "start": "concurrently \"tsc --watch\" \"npm run watch:html\" \"browser-sync start --server dist --files dist\""
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "rimraf": "^6.1.3",
    "copyfiles": "^2.4.1",
    "http-server": "^14.1.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "browser-sync": "^3.0.4"
  }
}
